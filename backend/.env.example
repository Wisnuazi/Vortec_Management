DATABASE_URL="postgresql://vortec:vortec_dev@localhost:5433/vortec_management?schema=public"
PORT=4000
# Comma-separated for multiple allowed origins — e.g. to let teammates on
# the same LAN reach a locally-hosted instance:
# CORS_ORIGIN=http://localhost:3000,http://192.168.1.23:3000
CORS_ORIGIN=http://localhost:3000
JWT_SECRET=replace-with-a-long-random-string

# Bootstrap super admin (used only by prisma/seed.ts). If SUPER_ADMIN_PASSWORD
# is left unset, the seed script generates a random password and prints it
# once to the console.
SUPER_ADMIN_EMAIL=vortec_dev@vortecsystem.com
SUPER_ADMIN_PASSWORD=

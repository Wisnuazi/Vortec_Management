# STAGING environment secrets
# --------------------------
# Copy to `.env.staging` and adjust before bringing up the staging
# stack. Never commit `.env.staging` (it is gitignored).
#
# Note: `DATABASE_URL` is overridden by docker-compose.staging.yml to
# point at the in-network `db` host (not localhost), same as dev.

PORT=4000
CORS_ORIGIN=http://localhost:3100

# Generate a fresh value for staging — DO NOT reuse the dev JWT_SECRET.
# Suggested: `openssl rand -base64 48`
JWT_SECRET=replace-with-a-long-random-string

# Super admin bootstrap for the fresh staging database. The seed will
# print the generated password to the container logs on first run.
SUPER_ADMIN_EMAIL=staging_admin@vortecsystem.com
SUPER_ADMIN_PASSWORD=
